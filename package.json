{
  "name": "lanka-blood-link",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names client,server --prefix-colors cyan,magenta \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "client": "npm run dev --workspace client",
    "server": "npm run dev --workspace server",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
